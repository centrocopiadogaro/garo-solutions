<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>GARO CONTROL</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="./config.js"></script>
<style>
:root{--blue:#24527A;--dark:#173C5C;--gold:#FFC700;--bg:#F4F7F9;--line:#DCE4EA;--muted:#687987;--good:#167044;--bad:#B91C1C}
*{box-sizing:border-box}body{margin:0;background:var(--bg);font-family:Arial,Helvetica,sans-serif;color:#173042}
.wrap{max-width:1180px;margin:auto;padding:20px}
.top{background:#fff;border-radius:18px;padding:16px;display:flex;justify-content:space-between;align-items:center;gap:12px;border:1px solid var(--line);margin-bottom:14px}
.brand{display:flex;align-items:center;gap:12px}.brand img{width:70px;height:70px;object-fit:contain;border-radius:12px}h1{margin:0;color:var(--dark);font-size:23px}h2{color:var(--dark);font-size:17px;margin:0 0 12px}.sub{margin:3px 0 0;color:var(--muted);font-size:12px}
.btn{border:0;border-radius:11px;padding:11px 15px;min-height:44px;font-weight:800;cursor:pointer}.primary{background:var(--blue);color:#fff}.secondary{background:#EEF3F7;color:var(--dark)}.danger{background:#FFF0F0;color:var(--bad)}
.panel{background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px;margin-top:12px}
.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.card{background:#fff;border:1px solid var(--line);border-radius:15px;padding:14px;border-top:4px solid var(--blue)}.card.gold{border-top-color:var(--gold)}.lab{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase}.num{font-size:23px;font-weight:800;margin-top:4px}
.formgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}label{font-size:12px;font-weight:700;display:block;margin-bottom:5px}input,textarea{width:100%;padding:10px;border:1px solid #CBD5DC;border-radius:10px;font-size:16px}textarea{min-height:60px;resize:vertical}input:focus,textarea:focus{outline:2px solid var(--gold)}
.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:900px;font-size:12px}th,td{padding:8px;border-bottom:1px solid var(--line);text-align:right}th:first-child,td:first-child,td:nth-child(2){text-align:left}th{color:var(--muted);font-size:10px;text-transform:uppercase}.good{color:var(--good)}.bad{color:var(--bad)}
.weekgrid{display:grid;grid-template-columns:repeat(5,1fr);gap:9px}.week{background:var(--bg);padding:11px;border-radius:12px}.week strong{color:var(--blue)}.week div{font-size:12px;margin-top:3px}
.login{max-width:430px;margin:60px auto;background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px}.login .brand{margin-bottom:16px}.msg{padding:10px;border-radius:10px;background:#F8FAFC;color:var(--muted);font-size:12px;margin:10px 0}.hidden{display:none}.bar{display:flex;gap:8px;flex-wrap:wrap}
@media(max-width:850px){.cards{grid-template-columns:repeat(2,1fr)}.formgrid{grid-template-columns:repeat(2,1fr)}.weekgrid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.wrap{padding:10px}.cards,.formgrid,.weekgrid{grid-template-columns:1fr}.top{align-items:flex-start;flex-direction:column}}
</style>
</head>
<body>
<div id="login" class="login">
  <div class="brand"><img src="data:image/png;base64," alt="Logo GARO"><div><h1>GARO CONTROL</h1><div class="sub">Control financiero privado</div></div></div>
  <h2>Acceso</h2>
  <div class="msg" id="configMsg">Conectando con la base de datos segura…</div>
  <form id="loginForm">
    <label>Correo</label><input id="email" type="email" required>
    <label style="margin-top:9px">Contraseña</label><input id="password" type="password" required>
    <div class="bar" style="margin-top:12px"><button class="btn primary" type="submit">Entrar</button><button class="btn secondary" id="signup" type="button">Crear acceso</button></div>
  </form>
  <div class="msg" id="loginMsg"></div>
</div>

<div id="app" class="wrap hidden">
  <div class="top"><div class="brand"><img src="data:image/png;base64," alt="Logo GARO"><div><h1>GARO CONTROL</h1><div class="sub">Histórico financiero · datos sincronizados</div></div></div><button class="btn secondary" id="logout">Cerrar sesión</button></div>
  <div class="cards">
    <div class="card gold"><div class="lab">Ventas</div><div class="num" id="kSales">$0.00</div></div>
    <div class="card"><div class="lab">Gastos operativos</div><div class="num" id="kExpenses">$0.00</div></div>
    <div class="card gold"><div class="lab">Utilidad operativa</div><div class="num" id="kProfit">$0.00</div></div>
    <div class="card"><div class="lab">Movimiento de efectivo</div><div class="num" id="kFlow">$0.00</div></div>
  </div>
  <div class="panel"><h2>💰 Deuda pendiente</h2><div class="cards"><div class="card"><div class="lab">Préstamos recibidos</div><div class="num" id="kLoans">$0.00</div></div><div class="card"><div class="lab">Abonos a deuda</div><div class="num" id="kDebtPaid">$0.00</div></div><div class="card gold"><div class="lab">Deuda pendiente</div><div class="num" id="kDebt">$0.00</div></div><div class="card"><div class="lab">Registros</div><div class="num" id="kRows">0</div></div></div></div>
  <div class="panel">
    <h2>➕ Registrar día</h2>
    <form id="entryForm">
      <div class="formgrid">
        <div><label>Fecha</label><input id="fecha" type="date" required></div>
        <div><label>Caja chica ($)</label><input id="caja_chica" type="number" min="0" step="0.01" value="0"></div>
        <div><label>No. de actas</label><input id="no_actas" type="number" min="0" step="1" value="0"></div>
        <div><label>Ventas tarjeta ($)</label><input id="ventas_tarjeta" type="number" min="0" step="0.01" value="0"></div>
        <div><label>Morralla / sobrante ($)</label><input id="morralla" type="number" min="0" step="0.01" value="0"></div>
        <div><label>Tony ($)</label><input id="tony" type="number" min="0" step="0.01" value="0"></div>
        <div><label>Carosol + Denny ($)</label><input id="carosol_denny" type="number" min="0" step="0.01" value="0"></div>
        <div><label>Salario Edgar ($)</label><input id="salario_edgar" type="number" min="0" step="0.01" value="0"></div>
        <div><label>Renta local ($)</label><input id="renta_local" type="number" min="0" step="0.01" value="0"></div>
        <div><label>Salario Mario ($)</label><input id="salario_mario" type="number" min="0" step="0.01" value="0"></div>
        <div><label>Mantenimiento ($)</label><input id="mantenimiento" type="number" min="0" step="0.01" value="0"></div>
        <div><label>Beca Alfredo ($)</label><input id="beca_alfredo" type="number" min="0" step="0.01" value="700"></div>
        <div><label>Otros gastos ($)</label><input id="otros_gastos" type="number" min="0" step="0.01" value="0"></div>
        <div><label>Mercancía recibida a crédito ($)</label><input id="prestamos_recibidos" type="number" min="0" step="0.01" value="0"><div class="sub" style="margin-top:4px">No aumenta el efectivo: se registra como deuda.</div></div>
        <div><label>Abono a deuda ($)</label><input id="pago_deudores" type="number" min="0" step="0.01" value="0"><div class="sub" style="margin-top:4px">Sí reduce el efectivo y la deuda; no es gasto.</div></div>
      </div>
      <label style="margin-top:10px">Observación</label><textarea id="observacion" placeholder="Ej. pago Tony, luz, compra de mercancía..."></textarea>
      <div class="bar" style="margin-top:10px"><button class="btn primary" type="submit">Guardar día</button><button class="btn secondary" id="clearForm" type="button">Limpiar</button><label class="btn secondary" style="display:inline-flex;align-items:center;cursor:pointer"><input id="importFile" type="file" accept=".json" style="display:none">Importar histórico JSON</label></div>
      <div class="msg" id="saveMsg"></div>
    </form>
  </div>
  <div class="panel">
    <h2>📅 Histórico</h2>
    <div class="tablewrap"><table><thead><tr><th>Fecha</th><th>Ventas</th><th>Gastos</th><th>Mercancía a crédito</th><th>Abono deuda</th><th>Movimiento efectivo</th><th>Utilidad real</th><th>Deuda pendiente</th><th></th></tr></thead><tbody id="history"></tbody></table></div>
  </div>
  <div class="panel"><h2>📊 Resumen semanal</h2><div class="weekgrid" id="weeks"></div></div>
  <div class="panel"><div class="msg">Lógica: <b>deuda pendiente = mercancía recibida a crédito acumulada − abonos acumulados</b>. La mercancía recibida a crédito <b>NO entra al efectivo</b> porque no se recibió dinero. Cuando esa mercancía se vende, la venta sí entra en ventas y efectivo. El abono sí sale del efectivo y reduce la deuda. Ninguno entra en la utilidad real.</div></div>
</div>

<script>
(() => {
  const cfg = window.GARO_CONFIG || {};
  const configured = cfg.supabaseUrl && cfg.supabaseAnonKey &&
    !cfg.supabaseUrl.includes(https://fegzcmkpbnhrqsbjlyqv.supabase.co) && !cfg.supabaseAnonKey.includes(sb_publishable_gcU4VcmJgKIpfXbDUbZXeQ_2YbqP3Mq);
  const configMsg = document.getElementById('configMsg');
  const loginMsg = document.getElementById('loginMsg');
  if (!configured) {
    configMsg.textContent = "Falta configurar Supabase en config.js (URL y anon key).";
  } else {
    configMsg.textContent = "Base de datos lista. Tus movimientos quedan asociados a tu usuario.";
  }
  const sb = configured ? window.supabase.createClient(cfg.supabaseUrl, cfg.supabaseAnonKey) : null;
  const $ = id => document.getElementById(id);
  const money = n => new Intl.NumberFormat('es-MX', {style:'currency',currency:'MXN'}).format(Number(n)||0);
  const keys = ['caja_chica','no_actas','ventas_tarjeta','morralla','tony','carosol_denny','salario_edgar','renta_local','salario_mario','mantenimiento','beca_alfredo','otros_gastos','prestamos_recibidos','pago_deudores'];
  let rows = [];

  function n(id) {
    const v = parseFloat($(id).value);
    return Number.isFinite(v) && v >= 0 ? v : 0;
  }
  function calc(r) {
    const legacyActs = (Number(r.no_actas)||0) > 0 ? 0 : (Number(r.actas_original)||0);
    const sales = (Number(r.caja_chica)||0) + (Number(r.no_actas)||0) * 120 + (Number(r.ventas_tarjeta)||0) + (Number(r.morralla)||0) + legacyActs;
    const expenses = ['tony','carosol_denny','salario_edgar','renta_local','salario_mario','mantenimiento','beca_alfredo','otros_gastos'].reduce((a,k)=>a+(Number(r[k])||0),0);
    const loan = Number(r.prestamos_recibidos)||0;
    const paid = Number(r.pago_deudores)||0;
    const cashMove = sales-expenses-paid;
    return {sales,expenses,profit:sales-expenses,cashMove,loan,paid};
  }
  function render() {
    rows.sort((a,b)=>String(a.fecha).localeCompare(String(b.fecha)));
    let ts=0,te=0,tl=0,tp=0;
    let debt=0;
    rows.forEach(r => { const c=calc(r); ts+=c.sales; te+=c.expenses; tl+=c.loan; tp+=c.paid; debt += c.loan-c.paid; });
    $('kSales').textContent=money(ts); $('kExpenses').textContent=money(te); $('kProfit').textContent=money(ts-te);
    $('kFlow').textContent=money(ts-te-tp); $('kLoans').textContent=money(tl); $('kDebtPaid').textContent=money(tp); $('kDebt').textContent=money(debt); $('kRows').textContent=rows.length;

    let runningDebt=0;
    const body = rows.map(r => {
      const c=calc(r); runningDebt += c.loan-c.paid;
      return `<tr><td>${r.fecha}</td><td>${money(c.sales)}</td><td>${money(c.expenses)}</td><td>${money(c.loan)}</td><td>${money(c.paid)}</td><td class="${c.cashMove>=0?'good':'bad'}">${money(c.cashMove)}</td><td>${money(c.profit)}</td><td>${money(runningDebt)}</td><td><button class="btn danger" data-del="${r.id}">×</button></td></tr>`;
    }).join('');
    $('history').innerHTML = body || '<tr><td colspan="9">No hay registros todavía.</td></tr>';
    document.querySelectorAll('[data-del]').forEach(b=>b.addEventListener('click',async()=>{
      if(!sb) return; const id=b.dataset.del; const {error}=await sb.from('movimientos').delete().eq('id',id); if(error) $('saveMsg').textContent=error.message; else {await load();}
    }));

    const weeks=[1,2,3,4,5];
    $('weeks').innerHTML = weeks.map(w=> {
      const rs=rows.filter(r=>Math.min(5,Math.floor((Number(String(r.fecha).slice(-2)) - 1)/7)+1)===w);
      const c=rs.reduce((a,r)=>{const x=calc(r);a.sales+=x.sales;a.exp+=x.expenses;a.loan+=x.loan;a.paid+=x.paid;return a},{sales:0,exp:0,loan:0,paid:0});
      return `<div class="week"><strong>Semana ${w}</strong><div>Ventas: ${money(c.sales)}</div><div>Gastos: ${money(c.exp)}</div><div>Préstamos: ${money(c.loan)}</div><div>Abonos: ${money(c.paid)}</div><div><b>Movimiento efectivo: ${money(c.sales-c.exp-c.paid)}</b></div></div>`;
    }).join('');
  }
  async function load() {
    if(!sb) return;
    const {data,error} = await sb.from('movimientos').select('*').order('fecha',{ascending:true});
    if(error) { loginMsg.textContent=error.message; return; }
    rows = data || []; render();
  }
  function showApp() { $('login').classList.add('hidden'); $('app').classList.remove('hidden'); load(); }
  function showLogin() { $('app').classList.add('hidden'); $('login').classList.remove('hidden'); }
  if(sb) {
    sb.auth.getSession().then(({
      data
    }) => { if(data && data.session) showApp(); });
    sb.auth.onAuthStateChange((_event,session)=>{ if(session) showApp(); else showLogin(); });
  }
  $('loginForm').addEventListener('submit', async e=>{
    e.preventDefault(); if(!sb) return;
    const {data,error}=await sb.auth.signInWithPassword({email:$('email').value.trim(),password:$('password').value});
    loginMsg.textContent = error ? error.message : 'Acceso correcto.';
    if(data && data.session) showApp();
  });
  $('signup').addEventListener('click', async()=>{
    if(!sb) return; const email=$('email').value.trim(), password=$('password').value;
    if(!email || password.length<6) {loginMsg.textContent='Captura correo y una contraseña de al menos 6 caracteres.';return;}
    const {error}=await sb.auth.signUp({email,password});
    loginMsg.textContent=error?error.message:'Cuenta creada. Revisa tu correo si Supabase solicita confirmación.';
  });
  $('logout').addEventListener('click',()=>sb && sb.auth.signOut());
  $('clearForm').addEventListener('click',()=>{keys.forEach(k=>$(k).value='0');$('beca_alfredo').value='700';$('observacion').value='';});
  $('entryForm').addEventListener('submit',async e=>{
    e.preventDefault(); if(!sb) return;
    const payload={fecha:$('fecha').value,observacion:$('observacion').value.trim(),actas_original:0};
    keys.forEach(k=>payload[k]=n(k));
    const {data:user}=await sb.auth.getUser(); payload.user_id=user.user.id;
    const {data,error}=await sb.from('movimientos').upsert(payload,{onConflict:'user_id,fecha'}).select().single();
    $('saveMsg').textContent=error?error.message:'Día guardado.';
    if(!error) { await load(); $('clearForm').click(); }
  });
  $('importFile').addEventListener('change',async e=>{
    if(!sb) return; const f=e.target.files[0]; if(!f) return;
    try {
      const data=JSON.parse(await f.text()); if(!Array.isArray(data)) throw new Error('El JSON debe contener una lista.');
      const {data:user}=await sb.auth.getUser();
      const clean=data.map(r=>({...r,user_id:user.user.id}));
      const {error}=await sb.from('movimientos').upsert(clean,{onConflict:'user_id,fecha'});
      $('saveMsg').textContent=error?error.message:`Importados ${clean.length} registros.`;
      if(!error) await load();
    } catch(err) { $('saveMsg').textContent=err.message; }
    e.target.value='';
  });
  const today=new Date(); $('fecha').value=today.toISOString().slice(0,10);
</script>
<script src="./app.js"></script>
</body>
</html>
